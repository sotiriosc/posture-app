# Copy these values into .env.local for DB-free local development.
# This mode does not use Neon/Postgres.

USER_STORE_DRIVER=memory
TRAINING_STORE_DRIVER=disabled
DATABASE_URL=
APP_URL=http://localhost:3000

# Optional future adaptive-generation flag.
# Default is off; leave unset for normal local development.
ADAPTIVE_PROGRAMMING_ENABLED=

# Optional local auth bootstrap. Use local-only values.
AUTH_SECRET=replace-with-local-dev-secret
AUTH_USER_EMAIL=local@example.com
AUTH_USER_PASSWORD=replace-with-local-password
AUTH_USER_PLAN=free

# Optional local admin gate.
ADMIN_ACCESS_KEY=replace-with-local-admin-key

# Optional Stripe test-mode values only when testing billing locally.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# Founders checkout uses STRIPE_PRICE_ID_MONTHLY + silent FOUNDERS promo ($19.99 − $7).
# STRIPE_PRICE_ID_FOUNDERS is unused (archived standalone founders price).
# Legacy single-price fallback (still accepted as monthly)
# STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional Google Analytics 4 (consumer app). Leave unset locally to skip GA.
# Production: set to the GA4 Measurement ID (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
