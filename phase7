```ts
type ProgramQualitySeverity =
  | "hardFailure"
  | "warning"
  | "capabilityLimitation"
  | "deferredContent";

type ProgramQualityFinding = {
  code: string;
  severity: ProgramQualitySeverity;

  mode:
    | "gym"
    | "dumbbells"
    | "bands"
    | "bodyweight"
    | "mixedHome";

