{
  "name": "@praxis/engine",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./outcome-source-persistence": "./src/outcomeSourcePersistence/index.ts"
  },
  "scripts": {
    "build:outcome-sources": "tsc -p tsconfig.outcome-sources.json --noEmit",
    "db:outcome-sources:migrations:plan": "node --import tsx src/outcomeSourcePersistence/cli.ts plan",
    "db:outcome-sources:migrate": "node --import tsx src/outcomeSourcePersistence/cli.ts apply",
    "test:outcome-sources:repository": "vitest --run --config vitest.config.ts tests/unit/outcomeSourcePostgresRepository.test.ts",
    "test:outcome-sources:postgres": "vitest --run --config vitest.config.ts tests/integration/outcomeSourcePostgres.integration.test.ts"
  },
  "dependencies": {
    "@praxis/training-engine-v2": "0.0.1",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.20.0",
    "next": "^16.2.11",
    "pg": "^8.18.0",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0"
  }
}
