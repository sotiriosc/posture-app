{
  "name": "@praxis/training-engine-v2",
  "version": "0.0.1",
  "private": true,
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "engine:v2:lab": "node --import tsx dev/manualCandidateLab.ts",
    "test": "vitest --run --config vitest.config.ts",
    "test:cagt": "vitest --run --config vitest.config.ts tests/unit/cagtCore.test.ts tests/unit/cagtAdaptersAndCohorts.test.ts",
    "test:cagt:stress": "vitest --run --config vitest.config.ts tests/unit/cagtStress.test.ts",
    "report:cagt": "node --import tsx dev/reportCagt.ts"
  }
}
