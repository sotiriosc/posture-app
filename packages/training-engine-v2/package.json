    "test:cagt:week-policy:holdout": "vitest --run --config vitest.config.ts tests/unit/cagtWeekPolicyHoldout.test.ts",
    "test:cagt:week-policy:stress": "vitest --run --config vitest.config.ts tests/unit/cagtWeekPolicyStress.test.ts",
    "report:cagt:week-policy": "node --import tsx dev/reportWeekPolicyTournament.ts",
