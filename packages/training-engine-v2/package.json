    "test:cagt:prescription-full-session": "vitest --run --config vitest.config.ts tests/unit/cagtPrescriptionFullSession.test.ts",
    "test:cagt:prescription-duration-truth": "vitest --run --config vitest.config.ts tests/unit/cagtPrescriptionDurationTruth.test.ts",
    "test:cagt:prescription-performance-independence": "vitest --run --config vitest.config.ts tests/unit/cagtPrescriptionPerformanceIndependence.test.ts",
    "test:cagt:prescription-policy-v2-holdout": "vitest --run --config vitest.config.ts tests/unit/cagtPrescriptionPolicyV2Holdout.test.ts",
    "report:cagt:prescription-policy-v2": "node --import tsx dev/reportPrescriptionPolicyV2.ts",
