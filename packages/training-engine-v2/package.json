    "test:cagt:prescription-policy-v1:full-session": "vitest --run --config vitest.config.ts tests/unit/cagtPrescriptionPolicyV1FullSession.test.ts",
    "test:cagt:prescription-policy-v1:performance": "vitest --run --config vitest.config.ts tests/unit/cagtPrescriptionPolicyV1Performance.test.ts",
    "report:cagt:prescription-policy-v1": "node --import tsx dev/reportPrescriptionPolicyV1.ts",
    "report:cagt:prescription-policy-v1:duration": "node --import tsx dev/reportPrescriptionPolicyV1.ts",
    "report:cagt:prescription-distribution": "node --import tsx dev/reportPrescriptionPolicyTournament.ts",
