{
  "name": "praxis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/consumer",
    "build": "npm run build --workspace=apps/consumer",
    "start": "npm run start --workspace=apps/consumer",
    "lint": "eslint",
    "test": "vitest",
    "test:benchmark": "vitest --run packages/engine/tests/unit/competitiveBenchmark.test.ts",
    "test:golden": "vitest --run packages/engine/tests/unit/programGoldenAnchors.test.ts packages/engine/tests/unit/programIdentityAnchors.test.ts packages/engine/tests/unit/questionnaireGoldenFlow.test.ts",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test --config=apps/consumer/playwright.config.ts",
    "test:critical": "vitest run --config packages/engine/vitest.config.ts packages/engine/tests/unit/programGoldenAnchors.test.ts packages/engine/tests/unit/programIdentityAnchors.test.ts packages/engine/tests/unit/questionnaireGoldenFlow.test.ts packages/engine/tests/unit/programDeterminism.test.ts packages/engine/tests/unit/competitiveBenchmark.test.ts packages/engine/tests/unit/catalogLadderInvariants.test.ts packages/engine/tests/unit/stripeWebhookLogic.test.ts packages/engine/tests/unit/stripeWebhookVerification.test.ts packages/engine/tests/unit/billingDisplay.test.ts packages/engine/tests/unit/stripeSubscriptionSnapshot.test.ts packages/engine/tests/unit/mergeReadinessAnchors.test.ts packages/engine/tests/unit/feedbackContractModify.test.ts packages/engine/tests/unit/feedbackContractSacrifice.test.ts packages/engine/tests/unit/feedbackContractSuppression.test.ts packages/engine/tests/unit/feedbackContractTest.test.ts packages/engine/tests/unit/ladderAdvancementCriteria.test.ts packages/engine/tests/unit/ladderAdvancementDeterminism.test.ts packages/engine/tests/unit/ladderSafetyFloor.test.ts packages/engine/tests/unit/ladderVariationConstraint.test.ts packages/engine/tests/unit/phaseGatingDeterminism.test.ts packages/engine/tests/unit/programPhaseProgressionCoherence.test.ts packages/engine/tests/unit/programProgressionTransition.test.ts packages/engine/tests/unit/progression.test.ts packages/engine/tests/unit/accountIsolation.test.ts packages/engine/tests/unit/coachNoteStore.test.ts packages/engine/tests/unit/focusSentence.test.ts packages/engine/tests/unit/baselineMetricCopy.test.ts packages/engine/tests/unit/centrationCues.test.ts packages/engine/tests/unit/offlineSyncQueue.test.ts packages/engine/tests/unit/subscriptionStore.test.ts packages/engine/tests/unit/operatorMetrics.test.ts packages/engine/tests/unit/adminUserAllowlist.test.ts",
    "test:full": "vitest --run --config packages/engine/vitest.config.ts",
    "test:full:gyms": "vitest --run --config apps/gyms/vitest.config.ts",
    "test:full:consumer": "vitest --run --config apps/consumer/vitest.config.ts",
    "test:e2e:smoke:consumer": "cd apps/consumer && playwright test tests/e2e/firstRunHappyPath.spec.ts tests/e2e/perAccountStateIsolation.spec.ts tests/e2e/firstRunCalm.spec.ts",
    "test:e2e:smoke:gyms": "cd apps/gyms && PLAYWRIGHT_PORT=3100 playwright test tests/e2e/firstRunHappyPath.spec.ts tests/e2e/perAccountStateIsolation.spec.ts",
    "test:engine": "node --import tsx packages/engine/src/__debug__/engineMatrixTest.ts",
    "audit:catalog": "node --import tsx packages/engine/src/__debug__/catalogAudit.ts",
    "audit:store": "node --import tsx packages/engine/src/__debug__/storeIntegritySmoke.ts",
    "audit:phase-matrix": "node --import tsx packages/engine/src/__debug__/phaseMatrixProgramPrint.ts",
    "audit:coverage-matrix": "node --import tsx packages/engine/src/__debug__/coverageContractAudit.ts",
    "audit:program-contract": "node --import tsx packages/engine/src/__debug__/programContractAudit.ts",
    "audit:decision-trace": "node --import tsx packages/engine/src/__debug__/decisionTraceAudit.ts",
    "debug:program": "node --import tsx packages/engine/src/__debug__/printProgram.ts",
    "smoke:photo-ns": "node --import tsx packages/engine/src/__debug__/photoNamespaceSmoke.ts",
    "smoke:phase": "node --import tsx packages/engine/src/__debug__/phaseEligibilitySmoke.ts",
    "db:outcome-sources:migrations:plan": "node --import tsx packages/engine/src/outcomeSourcePersistence/cli.ts plan",
    "db:outcome-sources:migrate": "node --import tsx packages/engine/src/outcomeSourcePersistence/cli.ts apply",
    "test:outcome-sources": "npm run test:outcome-sources --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:contracts": "npm run test:outcome-sources:contracts --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:adapters": "npm run test:outcome-sources:adapters --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:idempotency": "npm run test:outcome-sources:idempotency --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:revisions": "npm run test:outcome-sources:revisions --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:repository": "npm run test:outcome-sources:repository --workspace=@praxis/engine",
    "test:outcome-sources:postgres": "npm run test:outcome-sources:postgres --workspace=@praxis/engine",
    "test:outcome-sources:snapshot": "npm run test:outcome-sources:snapshot --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:replay": "npm run test:outcome-sources:replay --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:legacy": "npm run test:outcome-sources:legacy --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:golden": "npm run test:outcome-sources:golden --workspace=@praxis/training-engine-v2",
    "test:outcome-sources:stress": "npm run test:outcome-sources:stress --workspace=@praxis/training-engine-v2",
    "report:outcome-sources": "npm run report:outcome-sources --workspace=@praxis/training-engine-v2",
    "report:outcome-sources:legacy": "npm run report:outcome-sources:legacy --workspace=@praxis/training-engine-v2",
    "report:outcome-sources:golden": "npm run report:outcome-sources:golden --workspace=@praxis/training-engine-v2",
    "report:outcome-sources:stress": "npm run report:outcome-sources:stress --workspace=@praxis/training-engine-v2",
    "test:week-planner": "npm run test:week-planner --workspace=@praxis/training-engine-v2",
    "test:week-planner:contracts": "npm run test:week-planner:contracts --workspace=@praxis/training-engine-v2",
    "test:week-planner:policy": "npm run test:week-planner:policy --workspace=@praxis/training-engine-v2",
    "test:week-planner:intent": "npm run test:week-planner:intent --workspace=@praxis/training-engine-v2",
    "test:week-planner:allocation": "npm run test:week-planner:allocation --workspace=@praxis/training-engine-v2",
    "test:week-planner:oracle": "npm run test:week-planner:oracle --workspace=@praxis/training-engine-v2",
    "test:week-planner:search": "npm run test:week-planner:search --workspace=@praxis/training-engine-v2",
    "test:week-planner:materialization": "npm run test:week-planner:materialization --workspace=@praxis/training-engine-v2",
    "test:week-planner:reallocation": "npm run test:week-planner:reallocation --workspace=@praxis/training-engine-v2",
    "test:week-planner:golden": "npm run test:week-planner:golden --workspace=@praxis/training-engine-v2",
    "test:week-planner:holdout": "npm run test:week-planner:holdout --workspace=@praxis/training-engine-v2",
    "test:week-planner:stress": "npm run test:week-planner:stress --workspace=@praxis/training-engine-v2",
    "report:week-planner": "npm run report:week-planner --workspace=@praxis/training-engine-v2",
    "report:week-planner:golden": "npm run report:week-planner:golden --workspace=@praxis/training-engine-v2",
    "report:week-planner:stress": "npm run report:week-planner:stress --workspace=@praxis/training-engine-v2",
    "test:application-orchestration": "npm run test:application-orchestration --workspace=@praxis/training-engine-v2 && npm run test:application-orchestration:persistence --workspace=@praxis/engine",
    "test:application-orchestration:contracts": "npm run test:application-orchestration:contracts --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:owners": "npm run test:application-orchestration:owners --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:preconditions": "npm run test:application-orchestration:preconditions --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:prescription": "npm run test:application-orchestration:prescription --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:candidate-composer": "npm run test:application-orchestration:candidate-composer --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:week": "npm run test:application-orchestration:week --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:phase-safety": "npm run test:application-orchestration:phase-safety --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:downstream": "npm run test:application-orchestration:downstream --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:persistence": "npm run test:application-orchestration:persistence --workspace=@praxis/engine",
    "test:application-orchestration:postgres": "npm run test:application-orchestration:postgres --workspace=@praxis/engine",
    "test:application-orchestration:replay": "npm run test:application-orchestration:persistence --workspace=@praxis/engine -- -t replay",
    "test:application-orchestration:golden": "npm run test:application-orchestration:golden --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:holdout": "npm run test:application-orchestration:holdout --workspace=@praxis/training-engine-v2",
    "test:application-orchestration:stress": "npm run test:application-orchestration:stress --workspace=@praxis/training-engine-v2",
    "report:application-orchestration": "npm run report:application-orchestration --workspace=@praxis/training-engine-v2",
    "report:application-orchestration:golden": "npm run report:application-orchestration:golden --workspace=@praxis/training-engine-v2",
    "report:application-orchestration:stress": "npm run report:application-orchestration:stress --workspace=@praxis/training-engine-v2"
  },
  "dependencies": {
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.20.0",
    "@types/pg": "^8.16.0",
    "next": "^16.2.11",
    "next-plausible": "^4.0.0",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
